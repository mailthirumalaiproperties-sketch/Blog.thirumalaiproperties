{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thirumalai-cms-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thirumalai-cms",
      // Created 2026-11-03 in region APAC (npx wrangler d1 create thirumalai-cms --location apac)
      "database_id": "52b5b09a-f255-4898-b375-7219b1190e79",
      "migrations_dir": "migrations"
    }
  ],

  // Non-secret settings. Secrets (PASSWORD_PEPPER, SETUP_TOKEN, GITHUB_TOKEN)
  // are set with `npx wrangler secret put <NAME>` and never committed.
  "vars": {
    "ALLOWED_ORIGINS": "https://blog.thirumalaiproperties.com",
    "GITHUB_OWNER": "mailthirumalaiproperties-sketch",
    "GITHUB_REPO": "thirumalaiproperties.com",
    "GITHUB_WORKFLOW": "deploy.yml",
    "GITHUB_REF": "main"
  }
}
